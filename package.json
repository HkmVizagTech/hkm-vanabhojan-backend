{
  "name": "hkm-vanabhojan-backend",
  "version": "2.0.0",
  "description": "API for the Vanabhojanam Youth Festival: registration, payments, QR attendance, certificates",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "create-admin": "node scripts/create-admin.js",
    "seed-colleges": "node scripts/seed-colleges.js"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "testTimeout": 60000,
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
