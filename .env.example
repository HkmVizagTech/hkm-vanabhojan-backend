# --- required ---
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/vanabhojanam?retryWrites=true&w=majority
JWT_SECRET=                      # 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- server ---
NODE_ENV=development
PORT=3300
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,https://youthfest.harekrishnavizag.org   # empty = allow any origin
JWT_EXPIRES_IN=7d

# Fees, dates and venue are set per year in the admin console (Events); nothing to configure here.

# --- Razorpay (payments return 503 until the key pair is set) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=         # dashboard > Webhooks; events: payment.captured, payment.failed, refund.processed, refund.failed

# --- WhatsApp via Gupshup (notifications are skipped until set) ---
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=
GUPSHUP_APP_NAME=                  # the "App name" on the Gupshup Templates page
# Optional overrides of the approved template ids (defaults are built in):
# WA_TEMPLATE_FOLLOWUP=       approved invitation template for last year's attendees ({{1}} name, {{2}} event name)
# WA_TEMPLATE_REGISTRATION_STUDENT= WA_TEMPLATE_REGISTRATION_WORKING= WA_TEMPLATE_ACCEPT_MALE=
# WA_TEMPLATE_ACCEPT_FEMALE= WA_TEMPLATE_REJECT= WA_TEMPLATE_REMINDER= WA_TEMPLATE_CERTIFICATE= WA_TEMPLATE_CERTIFICATE_TEXT=

# --- Cloudflare R2 (student ID cards + certificates) ---
R2_ACCOUNT_ID=                   # dash.cloudflare.com > R2 > Overview (right side)
R2_ACCESS_KEY_ID=                # R2 > Manage API tokens > Create API token (Object Read & Write)
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                       # bucket for certificates (must be publicly readable)
R2_PUBLIC_URL=                   # https://pub-xxxx.r2.dev or your custom domain
R2_ID_BUCKET=                    # optional PRIVATE bucket for ID cards (recommended); defaults to R2_BUCKET

# --- background payment check ---
ENABLE_PAYMENT_CRON=true
PAYMENT_CRON_SCHEDULE=*/2 * * * *
PAYMENT_CRON_BATCH=50
